DATABASE_URL="postgresql://shop:shop@localhost:5434/stripe_payments"
PORT=3001
FRONTEND_ORIGIN=http://localhost:3000

# Dashboard -> Developers -> API keys, in a sandbox. Only sk_test_ keys are accepted.
STRIPE_SECRET_KEY=sk_test_replace_me
# Printed by `npm run stripe:secret` (Stripe CLI in Docker, uses the key above).
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# The reconcile job asks Stripe about orders still open after this many seconds.
RECONCILE_AFTER_SECONDS=120
# How often the job runs; 0 turns it off.
RECONCILE_INTERVAL_SECONDS=60
