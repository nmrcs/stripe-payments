generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model Product {
  id          String      @id @default(uuid()) @db.Uuid
  slug        String      @unique
  name        String
  description String
  // Smallest currency unit, as Stripe takes it.
  priceCents  Int
  currency    String      @db.Char(3)
  imageUrl    String
  orderItems  OrderItem[]
}

enum OrderStatus {
  pending
  processing
  paid
  failed
  expired
}

model Order {
  id              String      @id @default(uuid()) @db.Uuid
  status          OrderStatus @default(pending)
  totalCents      Int
  currency        String      @db.Char(3)
  // Set right after the Checkout Session is created; the reconcile job needs it.
  stripeSessionId String?     @unique
  createdAt       DateTime    @default(now())
  paidAt          DateTime?
  items           OrderItem[]

  @@index([status, createdAt])
}

model OrderItem {
  id             String  @id @default(uuid()) @db.Uuid
  orderId        String  @db.Uuid
  order          Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId      String  @db.Uuid
  product        Product @relation(fields: [productId], references: [id])
  quantity       Int
  // Copied at checkout: a later price change must not rewrite a past order.
  unitPriceCents Int

  @@index([orderId])
}

// One row per Stripe event id. Written in the same transaction as the order
// change, so a row means the event was applied, and a second delivery of the
// same id finds it and does nothing.
model StripeEvent {
  id        String   @id
  type      String
  orderId   String?  @db.Uuid
  createdAt DateTime @default(now())
}
